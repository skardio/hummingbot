# Trading Bot Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to git!

# Kraken API Keys
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET_KEY=your_kraken_secret_key_here

# Telegram Bot (for monitoring/alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Bitstamp API Keys (optional - for triangular arbitrage)
BITSTAMP_API_KEY=your_bitstamp_api_key_here
BITSTAMP_API_SECRET=your_bitstamp_secret_key_here

# Bitvavo API Keys (optional - for triangular arbitrage)
BITVAVO_API_KEY=your_bitvavo_api_key_here
BITVAVO_API_SECRET=your_bitvavo_secret_key_here

# Bot Environment (dev/test/prod)
BOT_ENV=prod
